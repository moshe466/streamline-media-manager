@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;

    --card: 222.2 84% 4.9%;
    --card-foreground: 210 40% 98%;

    --popover: 215 28% 17%;
    --popover-foreground: 210 40% 98%;

    --primary: 210 40% 98%;
    --primary-foreground: 222.2 47.4% 11.2%;

    --secondary: 217.2 32.6% 17.5%;
    --secondary-foreground: 210 40% 98%;

    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;

    --accent: 217.2 32.6% 17.5%;
    --accent-foreground: 210 40% 98%;

    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 210 40% 98%;

    --border: 217.2 32.6% 17.5%;
    --input: 217.2 32.6% 17.5%;
    --ring: 217.2 32.6% 17.5%;

    --radius: 0.5rem;
  }

  .dark {
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    
    --card: 222.2 84% 4.9%;
    --card-foreground: 210 40% 98%;
    
    /* Changed popover to be lighter for better contrast */
    --popover: 215 28% 17%; 
    --popover-foreground: 210 40% 98%;
    
    --primary: 210 40% 98%;
    --primary-foreground: 222.2 47.4% 11.2%;
    
    --secondary: 217.2 32.6% 17.5%;
    --secondary-foreground: 210 40% 98%;
    
    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;
    
    --accent: 217.2 32.6% 17.5%;
    --accent-foreground: 210 40% 98%;
    
    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 0 0% 98%;
    
    --border: 217.2 32.6% 17.5%;
    --input: 217.2 32.6% 17.5%;
    --ring: 217.2 32.6% 17.5%;
  }
}

@layer utilities {
  .dialog-content-light {
    @apply bg-gray-100 text-black;
  }
}


@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
}

/* Responsive table styles */
@media (max-width: 768px) {
  .responsive-table thead {
    @apply hidden;
  }
  .responsive-table tr {
    @apply block mb-4 border rounded-lg p-4;
  }
  .responsive-table td {
    @apply flex justify-between items-center text-right py-2 border-b border-dashed border-border/50;
  }
  .responsive-table td:last-child {
    @apply border-b-0;
  }
  .responsive-table td::before {
    content: attr(data-label);
    @apply font-semibold ml-2;
  }
}

/* Responsive Dialog styles */
@media (max-width: 640px) {
  [role="dialog"][data-state="open"] {
    width: 90%;
    max-width: 90%;
    border-radius: 1rem; /* Softer radius for mobile */
  }
}

/* ===== Admin Broadcast Control UI ===== */

.admin-control-bg {
  background:
    radial-gradient(circle at top right, rgba(124, 58, 237, 0.18), transparent 34%),
    radial-gradient(circle at bottom left, rgba(14, 165, 233, 0.12), transparent 32%),
    linear-gradient(135deg, #020617 0%, #07111f 45%, #020617 100%);
}

.admin-glass-card {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 20px 80px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px);
  border-radius: 1.25rem;
}

.admin-stream-card {
  background:
    linear-gradient(180deg, rgba(15,23,42,.92), rgba(2,6,23,.96));
  border: 1px solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 18px 55px rgba(0,0,0,.32);
  border-radius: 1.35rem;
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}

.admin-stream-card:hover {
  transform: translateY(-3px);
  border-color: rgba(124, 58, 237, 0.55);
  box-shadow: 0 24px 90px rgba(88, 28, 135, .26);
}

.admin-stream-online {
  box-shadow: 0 0 0 1px rgba(34,197,94,.18), 0 18px 55px rgba(0,0,0,.32);
}

.admin-stream-offline {
  box-shadow: 0 0 0 1px rgba(239,68,68,.16), 0 18px 55px rgba(0,0,0,.32);
}

.admin-kpi-card {
  background: rgba(15, 23, 42, 0.64);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 1.15rem;
  backdrop-filter: blur(16px);
}

.admin-status-dot {
  width: .55rem;
  height: .55rem;
  border-radius: 999px;
  display: inline-block;
}

.admin-status-dot.online {
  background: #22c55e;
  box-shadow: 0 0 18px rgba(34,197,94,.9);
}

.admin-status-dot.offline {
  background: #ef4444;
  box-shadow: 0 0 18px rgba(239,68,68,.75);
}

.admin-tech-button {
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.72);
}

.admin-tech-input {
  border-radius: 999px;
  background: rgba(2, 6, 23, 0.55);
  border-color: rgba(148, 163, 184, 0.18);
}

