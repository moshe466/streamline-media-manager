'use client';

import { memo, Suspense, useEffect, useMemo, useRef, useState } from 'react';
import { useSearchParams } from 'next/navigation';
import { AlertTriangle, Loader2, Tv } from 'lucide-react';
import { getStreams, getFlussonicConnectionDetails, type FlussonicStream } from '@/services/flussonic';
import { getAndConsumeMultiviewSettings } from '@/services/multiview-tokens';
import { type MultiviewSettings } from '@/services/users';
import { getClientById } from '@/services/clients';
import { Logo } from '@/components/logo';

const arraysEqual = (a: string[], b: string[]) =>
  a.length === b.length && a.every((value, index) => value === b[index]);

const statusEqual = (a: Record<string, string>, b: Record<string, string>) => {
  const ak = Object.keys(a);
  const bk = Object.keys(b);
  return ak.length === bk.length && ak.every((key) => a[key] === b[key]);
};

const VideoPlayer = memo(function VideoPlayer({ streamName, host }: { streamName: string; host: string }) {
  if (!host) {
    return (
      <div className="flex h-full w-full items-center justify-center bg-black">
        <Loader2 className="h-6 w-6 animate-spin text-cyan-300" />
      </div>
    );
  }

  const videoSrc =
    'https://' +
    host +
    '/' +
    streamName +
    '/embed.html?proto=mse&dvr=false&realtime=true&muted=true&autoplay=true&controls=false&chromeless=true&liveSyncDurationCount=6&quality=low';

  return (
    <iframe
      src={videoSrc}
      allowFullScreen
      allow="autoplay"
      className="h-full w-full border-0 bg-black"
    />
  );
});

const LoadingScreen = ({ text = 'טוען קיר מסכים...' }: { text?: string }) => (
  <div className="flex h-screen flex-col items-center justify-center bg-black text-white">
    <Logo className="mb-8 h-24 w-48" />
    <Loader2 className="h-12 w-12 animate-spin text-cyan-300" />
    <p className="mt-4 text-lg">{text}</p>
  </div>
);

function MultiviewPlayerContent() {
  const searchParams = useSearchParams();

  const [settings, setSettings] = useState<MultiviewSettings | null>(null);
  const [publicHost, setPublicHost] = useState('');
  const [streamsStatus, setStreamsStatus] = useState<Record<string, string>>({});
  const [allowedNames, setAllowedNames] = useState<string[]>([]);
  const [isLoadingSettings, setIsLoadingSettings] = useState(true);
  const [isLoadingChannels, setIsLoadingChannels] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const statusRef = useRef<Record<string, string>>({});
  const allowedRef = useRef<string[]>([]);
  const settingsRef = useRef<MultiviewSettings | null>(null);

  useEffect(() => {
    const requestId = searchParams.get('reqId');

    if (!requestId) {
      setError('מזהה בקשה לא סופק. לא ניתן לטעון את הנגן.');
      setIsLoadingSettings(false);
      setIsLoadingChannels(false);
      return;
    }

    let cancelled = false;
    let interval: NodeJS.Timeout | null = null;
    let timeout: NodeJS.Timeout | null = null;

    const loadSettings = async (): Promise<boolean> => {
      try {
        const cacheKey = 'multiview-settings-' + requestId;
        const cached = sessionStorage.getItem(cacheKey);

        const result: MultiviewSettings | null = cached
          ? JSON.parse(cached)
          : await getAndConsumeMultiviewSettings(requestId);

        if (!result) return false;

        if (!cached) {
          sessionStorage.setItem(cacheKey, JSON.stringify(result));
        }

        const connection = await getFlussonicConnectionDetails();

        if (cancelled) return true;

        settingsRef.current = result;
        setSettings(result);
        setPublicHost(connection.publicHost);
        setIsLoadingSettings(false);

        if (interval) clearInterval(interval);
        if (timeout) clearTimeout(timeout);

        return true;
      } catch (err) {
        console.error('settings load error:', err);
        return false;
      }
    };

    loadSettings();
    interval = setInterval(loadSettings, 1000);

    timeout = setTimeout(() => {
      if (interval) clearInterval(interval);

      const cached = sessionStorage.getItem('multiview-settings-' + requestId);
      if (cached) {
        try {
          const parsed = JSON.parse(cached);
          settingsRef.current = parsed;
          setSettings(parsed);
          setIsLoadingSettings(false);
          return;
        } catch {}
      }

      setError('לא ניתן היה לטעון את הגדרות הצפייה. פתח חלון חדש מה-MCR.');
      setIsLoadingSettings(false);
      setIsLoadingChannels(false);
    }, 20000);

    return () => {
      cancelled = true;
      if (interval) clearInterval(interval);
      if (timeout) clearTimeout(timeout);
    };
  }, [searchParams]);

  useEffect(() => {
    if (!settings) return;

    let cancelled = false;

    const refreshChannels = async () => {
      try {
        const [allStreams, client] = await Promise.all([
          getStreams().catch(() => [] as FlussonicStream[]),
          settings.clientId ? getClientById(settings.clientId).catch(() => null) : Promise.resolve(null),
        ]);

        if (cancelled) return;

        const nextStatus: Record<string, string> = {};
        allStreams.forEach((stream) => {
          nextStatus[stream.name] = stream.status;
        });

        let nextAllowed: string[] = settings.selectedStreams || [];

        if (client) {
          if (!client.permissions?.hasAllStreamsAccess) {
            const allowed = Object.keys(client.permissions?.allowedStreams || {});
            nextAllowed = nextAllowed.filter((name) => allowed.includes(name));
          }
        }

        if (!statusEqual(statusRef.current, nextStatus)) {
          statusRef.current = nextStatus;
          setStreamsStatus(nextStatus);
        }

        if (!arraysEqual(allowedRef.current, nextAllowed)) {
          allowedRef.current = nextAllowed;
          setAllowedNames(nextAllowed);
        }

        setIsLoadingChannels(false);
      } catch (err) {
        console.error('channels refresh error:', err);
        setIsLoadingChannels(false);
      }
    };

    refreshChannels();
    const interval = setInterval(refreshChannels, 30000);

    return () => {
      cancelled = true;
      clearInterval(interval);
    };
  }, [settings]);

  const onlineStreams = useMemo(() => {
    return allowedNames.filter((name) => streamsStatus[name] === 'online');
  }, [allowedNames, streamsStatus]);

  if (isLoadingSettings) return <LoadingScreen text="טוען את הגדרות קיר המסכים..." />;

  if (error) {
    return (
      <div className="flex h-screen flex-col items-center justify-center bg-black text-white">
        <AlertTriangle className="h-12 w-12 text-red-500" />
        <h1 className="mt-4 text-2xl font-bold">שגיאה</h1>
        <p className="mt-2 text-red-400">{error}</p>
      </div>
    );
  }

  if (isLoadingChannels) return <LoadingScreen text="טוען את רשימת הערוצים..." />;

  if (onlineStreams.length === 0) {
    return (
      <div className="flex h-screen flex-col items-center justify-center bg-black text-white">
        <Tv className="h-12 w-12 text-zinc-600" />
        <h1 className="mt-4 text-2xl font-bold">אין כרגע שידורים פעילים</h1>
        <p className="mt-2 text-sm text-zinc-500">הקיר יתעדכן לבד כשערוץ מורשה יחזור ללייב.</p>
      </div>
    );
  }

  const columns = settings?.gridColumns || 2;
  const rows = Math.max(1, Math.ceil(onlineStreams.length / columns));

  return (
    <main
      className="grid h-screen w-screen overflow-hidden bg-black"
      style={{
        gridTemplateColumns: 'repeat(' + columns + ', minmax(0, 1fr))',
        gridTemplateRows: 'repeat(' + rows + ', minmax(0, 1fr))',
        gap: '1px',
        padding: '1px',
      }}
    >
      {onlineStreams.map((name) => (
        <div key={name} className="relative h-full w-full overflow-hidden bg-black">
          <VideoPlayer streamName={name} host={publicHost} />
        </div>
      ))}
    </main>
  );
}

export default function MultiviewPlayerPage() {
  return (
    <Suspense fallback={<LoadingScreen />}>
      <MultiviewPlayerContent />
    </Suspense>
  );
}
