import Link from 'next/link';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import {
  Tv,
  Users,
  Link2,
  Grid,
  CalendarClock,
  Wifi,
  WifiOff,
  ExternalLink,
  MailQuestion,
  Upload,
  FileText,
  Activity,
  Radio,
  ShieldCheck,
  PlayCircle,
} from 'lucide-react';
import { getClientById } from '@/services/clients';
import { getStreams, type FlussonicStream } from '@/services/flussonic';
import { getViewersByClientId } from '@/services/viewers';
import { getViewerRequestsByClientId } from '@/services/requests';
import { listClientDocuments } from '@/services/storage';
import { format, parseISO, isPast, startOfMonth } from 'date-fns';

export const dynamic = 'force-dynamic';
export const revalidate = 0;

const HERO_IMAGE =
  'https://firebasestorage.googleapis.com/v0/b/streamline-media-manager.firebasestorage.app/o/logo%2F5713eba4-f00b-4623-a670-7aeaf1868ad4.png?alt=media&token=ffabf311-11c7-4ad2-b953-a0317e7202f6';

export default async function ClientDashboardPage({ params }: { params: { clientId: string } }) {
  const clientId = decodeURIComponent(params.clientId);

  const [client, allStreams, viewers, requests, documents] = await Promise.all([
    getClientById(clientId),
    getStreams().catch(() => []),
    getViewersByClientId(clientId).catch(() => []),
    getViewerRequestsByClientId(clientId).catch(() => []),
    listClientDocuments(clientId).catch(() => []),
  ]);

  if (!client) {
    return (
      <div className="p-8">
        <Card>
          <CardContent className="p-6 text-right">לא ניתן היה לטעון את פרטי הלקוח.</CardContent>
        </Card>
      </div>
    );
  }

  const authorizedStreams = client.permissions.hasAllStreamsAccess
    ? allStreams
    : allStreams.filter((stream: FlussonicStream) =>
        Object.keys(client.permissions.allowedStreams || {}).includes(stream.name)
      );

  const onlineStreams = authorizedStreams.filter((s) => s.status === 'online');
  const offlineStreams = authorizedStreams.length - onlineStreams.length;
  const inactiveViewers = viewers.filter((v) => v.expiresAt && isPast(parseISO(v.expiresAt))).length;
  const pendingRequests = requests.filter((r) => r.status === 'pending').length;
  const startOfCurrentMonth = startOfMonth(new Date());
  const newDocumentsCount = documents.filter((doc) => new Date(doc.timeCreated) >= startOfCurrentMonth).length;

  const kpis = [
    { label: 'שידורים', value: authorizedStreams.length, icon: Tv, color: 'text-cyan-300' },
    { label: 'LIVE', value: onlineStreams.length, icon: Wifi, color: 'text-green-300' },
    { label: 'צופים', value: viewers.length, icon: Users, color: 'text-blue-300' },
    { label: 'בקשות', value: pendingRequests, icon: MailQuestion, color: 'text-orange-300' },
    { label: 'מסמכים', value: documents.length, icon: FileText, color: 'text-purple-300' },
  ];

  const quickActions = [
    { label: 'צור שידור', href: `/client/${clientId}/streams/new`, icon: PlayCircle },
    { label: 'ניהול שידורים', href: `/client/${clientId}/streams`, icon: Tv },
    { label: 'ניהול צופים', href: `/client/${clientId}/viewers`, icon: Users },
    { label: 'קונטרול MCR', href: `/client/${clientId}/mcr`, icon: Grid },
    { label: 'קישורים', href: `/client/${clientId}/links`, icon: Link2 },
    { label: 'מסמכים', href: `/client/${clientId}/documents`, icon: Upload },
  ];

  return (
    <main dir="rtl" className="client-mission-control space-y-8 p-4 sm:p-6 lg:p-8 text-right">
      <section className="relative overflow-hidden rounded-[2rem] border border-cyan-400/20 bg-slate-950 p-6 shadow-2xl sm:p-8">
        <div className="absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-slate-950 to-orange-500/10" />
        <div className="absolute -left-20 top-10 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl" />
        <div className="absolute -bottom-24 right-20 h-72 w-72 rounded-full bg-orange-500/20 blur-3xl" />

        <div className="relative z-10 grid gap-8 lg:grid-cols-[1.4fr_.9fr]">
          <div className="space-y-6">
            <Badge className="w-fit rounded-full bg-cyan-500/15 px-4 py-2 text-cyan-100 hover:bg-cyan-500/20">
              <Radio className="ml-2 h-4 w-4 text-green-300" />
              Mission Control פעיל
            </Badge>

            <div>
              <h1 className="text-4xl font-black tracking-tight text-white sm:text-5xl">
                שלום {client.nickname}
              </h1>
              <p className="mt-3 max-w-2xl text-lg text-slate-300">
                לוח הבקרה שלך לניהול שידורים, צופים, קישורים, מסמכים וניטור בזמן אמת.
              </p>
            </div>

            <div className="flex flex-wrap gap-3">
              <Button asChild size="lg" className="rounded-full bg-cyan-400 text-black hover:bg-cyan-300">
                <Link href={`/client/${clientId}/streams/new`}>
                  <PlayCircle className="ml-2 h-5 w-5" />
                  צור שידור חדש
                </Link>
              </Button>

              <Button asChild size="lg" variant="outline" className="rounded-full border-white/20 bg-white/5 text-white hover:bg-white/10">
                <Link href={`/client/${clientId}/mcr`}>
                  <Grid className="ml-2 h-5 w-5" />
                  פתיחת MCR
                </Link>
              </Button>
            </div>
          </div>

          <div className="relative min-h-[260px] overflow-hidden rounded-[1.5rem] border border-white/10 bg-black/30">
            <img src={HERO_IMAGE} alt="Broadcast control" className="h-full w-full object-cover opacity-80" />
            <div className="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent" />
            <div className="absolute bottom-4 right-4 rounded-2xl border border-white/10 bg-black/50 p-4 text-white backdrop-blur-xl">
              <p className="text-sm text-slate-300">שידורים חיים</p>
              <p className="text-3xl font-black text-green-300">{onlineStreams.length}</p>
            </div>
          </div>

          <div className="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {kpis.map((item) => {
              const Icon=item.icon;
              return(
                <Link
                  key={item.label}
                  href={
                    item.label==="שידורים"
                      ? `/client/${clientId}/streams`
                      : item.label==="LIVE"
                      ? `/client/${clientId}/mcr`
                      : item.label==="צופים"
                      ? `/client/${clientId}/viewers`
                      : item.label==="בקשות"
                      ? `/client/${clientId}/requests`
                      : `/client/${clientId}/documents`
                  }
                >
                  <Card className="cursor-pointer border-white/10 bg-black/45 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:shadow-xl hover:shadow-cyan-500/20">
                    <CardContent className="p-5">
                      <div className="flex items-center justify-between">
                        <Icon className={`h-8 w-8 ${item.color}`} />
                        <div className="text-right">
                          <p className="text-3xl font-black text-white">
                            {item.value}
                          </p>
                          <p className="text-sm text-slate-300">
                            {item.label}
                          </p>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                </Link>
              )
            })}
          </div>

        </div>
      </section>
      <section className="grid gap-6 xl:grid-cols-[1.3fr_.7fr]">

        <Card className="border-cyan-400/10 bg-slate-950/70">
          <CardContent className="p-5">
            <div className="mb-5 flex items-center justify-between">
              <Button asChild variant="ghost" className="text-cyan-300">
                <Link href={`/client/${clientId}/streams`}>לכל השידורים</Link>
              </Button>
              <div>
                <h2 className="text-2xl font-black text-white">שידורים חיים</h2>
                <p className="text-sm text-slate-500">ניטור ערוצי השידור המרכזיים</p>
              </div>
            </div>

            {onlineStreams.length > 0 ? (
              <div className="grid gap-4 md:grid-cols-2">
                {onlineStreams.slice(0, 4).map((stream) => (
                  <Link key={stream.name} href={`/client/${clientId}/streams/${encodeURIComponent(stream.name)}`}>
                    <div className="group overflow-hidden rounded-2xl border border-white/10 bg-black transition hover:border-cyan-400/40">
                      <div className="aspect-video bg-gradient-to-br from-slate-800 to-black p-4">
                        <div className="flex h-full flex-col justify-between">
                          <Badge className="w-fit bg-red-600 text-white">LIVE</Badge>
                          <div>
                            <p className="truncate text-xl font-black text-white">{stream.name}</p>
                            <p className="text-sm text-green-300">Online</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </Link>
                ))}
              </div>
            ) : (
              <div className="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-700 py-16 text-center">
                <WifiOff className="h-12 w-12 text-slate-500" />
                <p className="mt-3 text-lg font-bold text-white">אין כרגע שידורים חיים</p>
              </div>
            )}
          </CardContent>
        </Card>

        <Card className="border-orange-400/10 bg-slate-950/70">
          <CardContent className="p-5">
            <h2 className="text-2xl font-black text-white">פעילות אחרונה</h2>
            <div className="mt-5 space-y-4">
              <div className="flex items-center justify-between border-b border-white/10 pb-3">
                <span className="text-slate-500">עכשיו</span>
                <span className="text-slate-300">{onlineStreams.length} שידורים פעילים</span>
              </div>
              <div className="flex items-center justify-between border-b border-white/10 pb-3">
                <span className="text-slate-500">היום</span>
                <span className="text-slate-300">{pendingRequests} בקשות ממתינות</span>
              </div>
              <div className="flex items-center justify-between border-b border-white/10 pb-3">
                <span className="text-slate-500">החודש</span>
                <span className="text-slate-300">{newDocumentsCount} מסמכים חדשים</span>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-slate-500">צופים לא פעילים</span>
                <span className="text-slate-300">{inactiveViewers}</span>
              </div>
            </div>
          </CardContent>
        </Card>
      </section>

      <section className="grid gap-6 xl:grid-cols-[.8fr_1.2fr]">
        <Card className="border-green-400/10 bg-slate-950/70">
          <CardContent className="p-5">
            <h2 className="text-2xl font-black text-white">סטטוס מערכת</h2>
            <div className="mt-5 space-y-3 text-sm">
              <div className="flex justify-between rounded-xl bg-white/5 p-3"><span className="text-green-300">מחובר</span><span className="text-slate-300">Flussonic</span></div>
              <div className="flex justify-between rounded-xl bg-white/5 p-3"><span className="text-green-300">פעיל</span><span className="text-slate-300">Push Server</span></div>
              <div className="flex justify-between rounded-xl bg-white/5 p-3"><span className="text-green-300">תקין</span><span className="text-slate-300">Storage</span></div>
              <div className="flex justify-between rounded-xl bg-white/5 p-3"><span className="text-orange-300">{offlineStreams}</span><span className="text-slate-300">שידורים לא פעילים</span></div>
            </div>
          </CardContent>
        </Card>

        <Card className="border-cyan-400/10 bg-slate-950/70">
          <CardContent className="p-5">
            <h2 className="text-2xl font-black text-white">פעולות מהירות</h2>
            <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {quickActions.map((action) => {
                const Icon = action.icon;
                return (
                  <Link key={action.href} href={action.href} className="rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:-translate-y-1 hover:border-cyan-400/40">
                    <Icon className="h-7 w-7 text-cyan-300" />
                    <p className="mt-3 font-bold text-white">{action.label}</p>
                  </Link>
                );
              })}
            </div>
          </CardContent>
        </Card>
      </section>

      <section>
        <Card className="border-white/10 bg-slate-950/70">
          <CardContent className="p-5">
            <h2 className="mb-5 text-2xl font-black text-white">שידורים אחרונים</h2>
            <div className="space-y-3">
              {authorizedStreams.slice(0, 8).map((stream) => (
                <div key={stream.name} className="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-4">
                  <Badge className={stream.status === 'online' ? 'bg-green-600' : 'bg-slate-600'}>
                    {stream.status === 'online' ? 'LIVE' : 'OFF'}
                  </Badge>
                  <div className="text-right">
                    <p className="font-bold text-white">{stream.name}</p>
                    <p className="text-xs text-slate-500">ערוץ שידור</p>
                  </div>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      </section>
    </main>
  );
}
