
'use client';

import { useState, useEffect, useCallback } from 'react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle, CardFooter } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Settings, X, Tv, Loader2, ExternalLink, Copy, SlidersHorizontal, ArrowRight } from 'lucide-react';
import { getStreams, getFlussonicConnectionDetails, type FlussonicStream } from '@/services/flussonic';
import { Skeleton } from '@/components/ui/skeleton';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter, DialogClose } from '@/components/ui/dialog';
import { Checkbox } from '@/components/ui/checkbox';
import { Label } from '@/components/ui/label';
import { ScrollArea } from '@/components/ui/scroll-area';
import { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';
import { cn } from '@/lib/utils';
import { useToast } from '@/hooks/use-toast';
import { updateClientDetails, type Client } from '@/services/clients';
import { createMultiviewRequest } from '@/services/multiview-tokens';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';
import { type MultiviewSettings } from '@/services/users';

export default function ClientMcrPage() {
    const params = useParams();
    const router = useRouter();
    const { toast } = useToast();
    
    // Ensure clientId is always decoded and available
    const clientId = decodeURIComponent(params.clientId as string);
    
    const [allStreams, setAllStreams] = useState<FlussonicStream[]>([]);
    const [publicHost, setPublicHost] = useState('');
    const [isLoading, setIsLoading] = useState(true);
    
    const [selectedStreamNames, setSelectedStreamNames] = useState<string[]>([]);
    const [gridColumns, setGridColumns] = useState<number>(3);
    const [isSettingsOpen, setIsSettingsOpen] = useState(false);
    const [isSaving, setIsSaving] = useState(false);
    const [isPreparingWindow, setIsPreparingWindow] = useState(false);
    
    const [tempSelectedNames, setTempSelectedNames] = useState<string[]>([]);
    const [tempGridColumns, setTempGridColumns] = useState<number>(3);

    const loadInitialData = useCallback(async () => {
        setIsLoading(true);
        try {
            const clientDataString = sessionStorage.getItem('clientData');
            if (!clientDataString) throw new Error('Client data not found in session.');
            const clientData: Client = JSON.parse(clientDataString);

            const [streams, connection] = await Promise.all([getStreams(), getFlussonicConnectionDetails()]);
            setPublicHost(connection.publicHost);
            const authorizedStreams = clientData.permissions.hasAllStreamsAccess
                ? streams
                : streams.filter(s => Object.keys(clientData.permissions.allowedStreams || {}).includes(s.name));
            
            setAllStreams(authorizedStreams);
            
            const savedSettings = clientData.multiviewSettings;
            if (savedSettings && savedSettings.selectedStreams.length > 0) {
                const validStreams = savedSettings.selectedStreams.filter(name => authorizedStreams.some(s => s.name === name));
                setSelectedStreamNames(validStreams);
                setGridColumns(savedSettings.gridColumns || 3);
            } else {
                // If no settings saved, or saved streams are empty, start with a blank slate
                setSelectedStreamNames([]);
                setGridColumns(3);
            }
        } catch (error) {
            toast({ variant: 'destructive', title: 'שגיאה', description: 'לא ניתן היה לטעון את הנתונים.' });
        } finally {
            setIsLoading(false);
        }
    }, [toast]);
    
    useEffect(() => {
        loadInitialData();
    }, [loadInitialData]);
    
    const handleOpenSettings = () => {
        setTempSelectedNames(selectedStreamNames);
        setTempGridColumns(gridColumns);
        setIsSettingsOpen(true);
    };

    const handleSaveSettings = async () => {
        setIsSaving(true);
        const newSettings: MultiviewSettings = {
            selectedStreams: tempSelectedNames,
            gridColumns: tempGridColumns
        };

        try {
            const updatedClient = await updateClientDetails(clientId, { multiviewSettings: newSettings });
            
            sessionStorage.setItem('clientData', JSON.stringify(updatedClient));
            window.dispatchEvent(new Event('clientDataUpdated'));

            setSelectedStreamNames(tempSelectedNames);
            setGridColumns(tempGridColumns);
            setIsSettingsOpen(false);
            toast({ title: 'ההגדרות נשמרו', description: 'התצוגה עודכנה.' });
        } catch(error) {
            toast({ variant: 'destructive', title: 'שגיאה בשמירה', description: (error as Error).message });
        } finally {
            setIsSaving(false);
        }
    };
    
    const handleGenerateAndOpen = async () => {
        if (selectedStreamNames.length === 0) {
            toast({ variant: 'destructive', title: 'לא נבחרו שידורים', description: 'יש לבחור לפחות שידור אחד בהגדרות.' });
            return;
        }
        setIsPreparingWindow(true);
        try {
            // Use simple random string instead of Node crypto
            const requestId = `req_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
            
            const playerUrl = `/multiview-player?reqId=${requestId}`;
            const playerWindow = window.open(playerUrl, '_blank', 'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=yes');

            if (!playerWindow) {
                toast({
                    variant: 'destructive',
                    title: 'פתיחת החלון נכשלה',
                    description: 'ודא שחוסם הפופאפים אינו פעיל עבור אתר זה.',
                    duration: 7000,
                });
                setIsPreparingWindow(false);
                return;
            }

            const result = await createMultiviewRequest(requestId, {
                selectedStreams: selectedStreamNames,
                gridColumns: gridColumns
            });

            if (!result.success) {
                throw new Error(result.error || "Failed to create a multiview request on the server.");
            }
        } catch (error) {
             toast({ variant: 'destructive', title: 'שגיאה ביצירת חלון צפייה', description: (error as Error).message });
        } finally {
            setIsPreparingWindow(false);
        }
    };
    
    const selectedOnlineStreamNames = selectedStreamNames.filter((name) =>
        allStreams.some((stream) => stream.name === name && stream.status === 'online')
    );

    const gridTemplateColumns = `repeat(${gridColumns}, minmax(0, 1fr))`;

    if (isLoading) {
        return (
            <div className="p-8 space-y-4">
                <Skeleton className="h-10 w-48" />
                <div className="grid grid-cols-3 gap-4"><Skeleton className="h-48 w-full" /><Skeleton className="h-48 w-full" /><Skeleton className="h-48 w-full" /></div>
            </div>
        )
    }

    return (
        <div className="client-mission-control h-full flex flex-col p-4 sm:p-6 lg:p-8 space-y-6 text-right">
            {/* Settings Dialog */}
            <Dialog open={isSettingsOpen} onOpenChange={setIsSettingsOpen}>
                <DialogContent className="sm:max-w-3xl border-cyan-400/20 bg-slate-950 text-white text-right">
                    <DialogHeader className="space-y-4 border-b border-cyan-400/20 pb-5">
                        <div className="flex items-center justify-between gap-4">
                            <div className="flex h-12 w-12 items-center justify-center rounded-2xl border border-cyan-400/30 bg-cyan-400/10">
                                <SlidersHorizontal className="h-6 w-6 text-cyan-300" />
                            </div>

                            <div className="text-right">
                                <DialogTitle className="text-2xl font-black text-white">
                                    הגדרות תצוגה מרובה
                                </DialogTitle>
                                <DialogDescription className="mt-1 text-slate-400">
                                    בחר אילו שידורים להציג וקבע את פריסת הרשת.
                                </DialogDescription>
                            </div>
                        </div>
                    </DialogHeader>

                    <div className="py-5 space-y-6">
                        <div>
                            <div className="mb-3 flex flex-row-reverse items-center justify-between gap-3">
                                <Label className="text-base font-bold text-white">
                                    בחר שידורים
                                </Label>
                                <div className="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs font-bold text-cyan-300">
                                    נבחרו: {tempSelectedNames.length}
                                </div>
                            </div>

                            <ScrollArea className="h-72 w-full rounded-2xl border border-white/10 bg-black/30 p-4">
                                <div className="grid gap-2 sm:grid-cols-2">
                                    {allStreams.map(stream => (
                                        <div
                                            key={stream.name}
                                            className="flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/5 p-3 transition hover:border-cyan-400/30 hover:bg-cyan-400/5"
                                        >
                                            <Checkbox
                                                id={stream.name}
                                                checked={tempSelectedNames.includes(stream.name)}
                                                onCheckedChange={(checked) => {
                                                    setTempSelectedNames(prev =>
                                                        checked ? [...prev, stream.name] : prev.filter(name => name !== stream.name)
                                                    );
                                                }}
                                            />
                                            <Label htmlFor={stream.name} className="flex-1 cursor-pointer truncate text-right text-sm text-slate-200">
                                                {stream.name}
                                            </Label>
                                        </div>
                                    ))}
                                </div>
                            </ScrollArea>
                        </div>

                        <div>
                            <Label className="text-base font-bold text-white">בחר פריסה</Label>
                            <ToggleGroup
                                type="single"
                                value={String(tempGridColumns)}
                                onValueChange={(val) => val && setTempGridColumns(Number(val))}
                                className="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4"
                            >
                                {[1, 2, 3, 4, 6, 8, 9, 12].map(cols => (
                                    <ToggleGroupItem
                                        key={cols}
                                        value={String(cols)}
                                        className="h-12 rounded-2xl border border-white/10 bg-white/5 text-lg font-black text-white data-[state=on]:border-cyan-400 data-[state=on]:bg-cyan-400 data-[state=on]:text-black"
                                    >
                                        {cols}
                                    </ToggleGroupItem>
                                ))}
                            </ToggleGroup>
                        </div>
                    </div>

                    <DialogFooter className="gap-2 border-t border-cyan-400/20 pt-5">
                        <DialogClose asChild>
                            <Button variant="outline" className="rounded-full border-white/20 bg-white/5 text-white hover:bg-white/10">
                                ביטול
                            </Button>
                        </DialogClose>

                        <Button
                            onClick={handleSaveSettings}
                            disabled={isSaving}
                            className="rounded-full bg-cyan-400 text-black hover:bg-cyan-300"
                        >
                            {isSaving && <Loader2 className="ml-2 h-4 w-4 animate-spin"/>}
                            שמור וסגור
                        </Button>
                    </DialogFooter>
                </DialogContent>
            </Dialog>
            
            <section className="relative overflow-hidden rounded-[2rem] border border-cyan-400/20 bg-slate-950 p-6 shadow-2xl sm:p-8">
                <div className="absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-slate-950 to-orange-500/10" />
                <div className="absolute -left-20 top-10 h-72 w-72 rounded-full bg-cyan-500/20 blur-3xl" />
                <div className="absolute -bottom-24 right-20 h-72 w-72 rounded-full bg-orange-500/20 blur-3xl" />

                <div className="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div className="space-y-4 text-right">
                        <div className="inline-flex w-fit items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 text-sm text-cyan-100">
                            <Tv className="h-4 w-4 text-cyan-300" />
                            תצוגה מרובה
                        </div>

                        <div>
                            <h1 className="text-4xl font-black tracking-tight text-white sm:text-5xl">קונטרול NCR</h1>
                            <p className="mt-3 max-w-2xl text-lg text-slate-300">
                                צפייה במספר שידורים במקביל לפי בחירתך ופריסת חלונות מותאמת.
                            </p>
                        </div>
                    </div>

                    <div className="flex flex-wrap gap-3">
                        <Button
                            variant="secondary"
                            onClick={handleGenerateAndOpen}
                            disabled={isPreparingWindow}
                            className="rounded-full bg-cyan-400 text-black hover:bg-cyan-300"
                        >
                            {isPreparingWindow ? <Loader2 className="ml-2 h-4 w-4 animate-spin" /> : <ExternalLink className="ml-2 h-4 w-4" />}
                            צפייה בחלון נפרד
                        </Button>

                        <Button
                            onClick={handleOpenSettings}
                            variant="outline"
                            className="rounded-full border-white/20 bg-white/5 text-white hover:bg-white/10"
                        >
                            <Settings className="ml-2 h-4 w-4" />
                            הגדרות
                        </Button>
                    </div>
                </div>
            </section>
            
            {selectedOnlineStreamNames.length > 0 ? (
                <Card className="flex-1 overflow-hidden border-cyan-400/10 bg-slate-950/70">
                    <CardHeader className="flex flex-row-reverse items-center justify-between">
                        <div className="text-right">
                            <CardTitle className="text-2xl font-black text-white">חלונות השידור</CardTitle>
                            <CardDescription className="mt-1 text-slate-500">
                                {selectedOnlineStreamNames.length} שידורים פעילים מוצגים
                            </CardDescription>
                        </div>

                        <div className="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-sm text-cyan-300">
                            {gridColumns} חלונות
                        </div>
                    </CardHeader>

                    <CardContent>
                        <div className="grid gap-3" style={{ gridTemplateColumns }}>
                            {Array.from({ length: selectedOnlineStreamNames.length }).map((_, index) => (
                                <div key={selectedOnlineStreamNames[index]} className="aspect-video relative overflow-hidden rounded-3xl border border-white/10 bg-black shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/50 hover:shadow-cyan-500/20">
                                   <iframe
src={
  publicHost
    ? 'https://' + publicHost + '/' + selectedOnlineStreamNames[index] + '/embed.html?proto=hls&dvr=false&muted=true&autoplay=true&controls=false&chromeless=true&quality=lowest'
    : ''
}
allow="autoplay"
className="absolute inset-0 h-full w-full border-0 bg-black"
/>

<div className="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/70 via-transparent to-black/20"></div>

<div className="absolute top-3 right-3 rounded-full bg-red-500 px-2 py-1 text-[10px] font-bold text-white">
LIVE
</div>

<div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 to-transparent p-4">
<div className="text-sm font-bold text-white truncate">
{selectedOnlineStreamNames[index]}
</div>


</div>
                                </div>
                            ))}
                        </div>
                    </CardContent>
                </Card>
            ) : (
                <Card className="flex-1 border-cyan-400/10 bg-slate-950/70">
                    <CardContent className="flex min-h-[420px] flex-col items-center justify-center text-center">
                        <Tv className="h-16 w-16 text-cyan-300/70" />
                        <p className="mt-4 text-lg font-bold text-white">לא נבחרו שידורים לתצוגה.</p>
                        <p className="text-slate-500">אין כרגע שידורים פעילים מתוך השידורים שנבחרו.</p>
                    </CardContent>
                </Card>
            )}
        </div>
    );
}
